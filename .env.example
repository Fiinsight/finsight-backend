# Copy this file to .env or export these variables before starting Spring Boot.
# Never commit real values.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# This exact URI must also be registered in Kakao Developers > Kakao Login > Redirect URI.
KAKAO_REDIRECT_URI=http://<your-lan-ip>:8080/api/auth/kakao/callback
KAKAO_APP_REDIRECT_URI=finsight://auth/kakao

# Required by the application in local development.
JWT_SECRET=replace-with-a-long-random-local-secret
