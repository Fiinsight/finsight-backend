# FinSight Backend 환경변수 예시 파일
# 실제 값을 채운 뒤 .env 로 복사해서 사용하세요. (.env는 git에 커밋하지 마세요)
# 아래 값을 하나도 설정하지 않아도 앱은 정상적으로 켜지고, 외부 API는 폴백(샘플) 데이터로 동작합니다.

# ---- PostgreSQL ----
# 로컬 docker-compose로 띄운 postgres 접속 정보입니다.
DB_URL=jdbc:postgresql://localhost:5432/finsight
DB_USERNAME=finsight
DB_PASSWORD=finsight

# ---- Redis ----
# 뉴스 중복 제거 캐시, KIS 토큰 캐시, DART corp_code 캐시 등에 사용됩니다.
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- AI 서비스 (finsight-ai, FastAPI) ----
# 뉴스 재작성 / 용어 설명 / 판단 피드백 생성을 담당하는 사이드카 서비스 주소입니다.
AI_BASE_URL=http://localhost:8001

# ---- 한국투자증권(KIS) Open API — 모의투자 서버 ----
# 코스피/코스닥 지수, 종목 시세, 일봉 차트 조회에 사용됩니다.
# 무료로 발급 가능: https://apiportal.koreainvestment.com (모의투자 신청 후 앱키/시크릿 발급)
# 값이 비어 있으면 KisClient가 자동으로 샘플(폴백) 시세를 반환하므로 앱은 정상 동작합니다.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=

# ---- 한국은행 ECOS (경제통계시스템) ----
# 기준금리, 원/달러 환율 조회에 사용됩니다.
# 무료로 발급 가능: https://ecos.bok.or.kr (오픈API 신청)
# 값이 비어 있으면 EcosClient가 자동으로 샘플(폴백) 값을 반환합니다.
ECOS_API_KEY=

# ---- 금융감독원 OpenDART ----
# 종목별 최근 공시 목록 조회에 사용됩니다.
# 무료로 발급 가능: https://opendart.fss.or.kr (오픈API 이용 신청)
# 값이 비어 있으면 DartClient가 빈 공시 목록을 반환합니다.
DART_API_KEY=
