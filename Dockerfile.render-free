FROM --platform=$BUILDPLATFORM gradle:8.14-jdk21 AS build
WORKDIR /workspace
COPY . .
RUN ./gradlew bootJar --no-daemon

FROM eclipse-temurin:21-jre-jammy AS java
FROM python:3.12-slim-bookworm
COPY --from=java /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk \
    PATH=/opt/java/openjdk/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    USE_REAL_LLM=false USE_REAL_EMBEDDINGS=false \
    REWRITE_WITH_LLM=false DOCENT_WITH_LLM=false FEEDBACK_WITH_LLM=false \
    LLM_PROVIDER=gemini ANONYMIZED_TELEMETRY=false
WORKDIR /app
COPY deploy/requirements-ai-free.txt /tmp/requirements-ai-free.txt
RUN pip install --no-cache-dir -r /tmp/requirements-ai-free.txt
# Pin the existing AI version; a deploy must not silently fetch changed code.
ADD https://codeload.github.com/Fiinsight/finsight-ai/tar.gz/8732c623b4b8178dd4b67138c15f7b13bd183546 /tmp/ai.tar.gz
RUN mkdir /app/ai && tar -xzf /tmp/ai.tar.gz -C /app/ai --strip-components=1 && rm /tmp/ai.tar.gz
COPY --from=build /workspace/build/libs/*.jar /app/app.jar
# Build the archive with no network or production configuration. Training exits
# at context refresh, before seed runners; these switches do not affect runtime.
RUN --network=none java -Djarmode=tools -jar /app/app.jar extract --destination /app/application \
    && cd /app/application \
    && java -Xmx192m -XX:+UseSerialGC -XX:TieredStopAtLevel=1 \
       -XX:ArchiveClassesAtExit=/app/application/application.jsa \
       -Dspring.context.exit=onRefresh -jar /app/application/app.jar \
       --spring.main.lazy-initialization=true --spring.main.web-application-type=none \
       --spring.jpa.hibernate.ddl-auto=none --spring.flyway.enabled=false \
       --spring.jpa.properties.hibernate.boot.allow_jdbc_metadata_access=false \
       --spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect \
       --finsight.auth.jwt-secret=cWEtYnVpbGQtb25seS1ub3QtYS1ydW50aW1lLWNyZWRlbnRpYWw= \
       --finsight.news.collection.enabled=false --finsight.feedback.on-startup=false
COPY --chmod=755 deploy/start-free.sh /app/start-free.sh
EXPOSE 10000
ENTRYPOINT ["/app/start-free.sh"]
